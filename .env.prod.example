# Production environment for the VPS deployment.
# Copy to .env.prod on the server and fill in real values. NEVER commit .env.prod.
#
#   cp .env.prod.example .env.prod && nano .env.prod

# --- Public site -----------------------------------------------------------
# The domain whose DNS A record points at this VPS. Caddy gets a TLS cert for it.
EUDAMED_DOMAIN=eudamed.example.com
# E-mail Let's Encrypt uses for expiry notices.
ACME_EMAIL=you@example.com

# --- Login (HTTP basic-auth enforced by Caddy) -----------------------------
# Generate the bcrypt hash on the server with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'choose-a-strong-password'
# Paste the FULL hash (starts with $2a$...). Keep the single quotes off the hash.
BASIC_AUTH_USER=team
BASIC_AUTH_HASH=REPLACE_WITH_BCRYPT_HASH

# --- Database --------------------------------------------------------------
POSTGRES_USER=eudamed
# Use a long random password, e.g.  openssl rand -base64 24
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=eudamed

# --- App -------------------------------------------------------------------
# Field profile: as-consult (your portfolio defaults) or universal.
EUDAMED_PROFILE=as-consult
