# Production environment for the VPS deployment (host nginx + certbot in front).
# Copy to .env.prod on the server and fill in real values. NEVER commit .env.prod.
#
#   cp .env.prod.example .env.prod && nano .env.prod

# --- Database --------------------------------------------------------------
POSTGRES_USER=eudamed
# Use a long random password, e.g.  openssl rand -base64 24
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=eudamed

# --- App -------------------------------------------------------------------
# Localhost port the app listens on for the host nginx to proxy to.
# Change only if 8090 is already used on the VPS.
APP_PORT=8090
# Field profile: as-consult (your portfolio defaults) or universal.
EUDAMED_PROFILE=as-consult

# NOTE: TLS and the login are handled by host nginx, NOT here:
#   * certbot issues/renews the Let's Encrypt cert for the subdomain
#   * nginx auth_basic + /etc/nginx/.htpasswd-eudamed provides the login
# See deploy/nginx-eudamed.conf and DEPLOY.md.
